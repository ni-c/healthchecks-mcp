{
  "name": "healthchecks-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.ni-c/healthchecks-mcp",
  "description": "MCP server for Healthchecks: inspect, create and adjust cron and uptime checks, and read why one failed",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "healthchecks",
    "healthchecks-io",
    "monitoring",
    "cron",
    "uptime",
    "dead-mans-switch"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/healthchecks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/healthchecks-mcp/issues"
  },
  "homepage": "https://healthchecks-mcp.ni-c.de",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "bin": {
    "healthchecks-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "assets": "svg-asset-set",
    "assets:check": "svg-asset-set --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-approval": "^0.7.0",
    "mcp-tool-allowlist": "^0.2.0",
    "undici": "^8.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "mcp-integration-harness": "^0.1.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "svg-asset-set": "https://github.com/ni-c/svg-asset-set/releases/download/v0.1.0/svg-asset-set-0.1.0.tgz",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
